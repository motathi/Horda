[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="hero"
3d_physics/layer_3="enemies"
3d_physics/layer_4="structures"
3d_physics/layer_5="gate"
3d_physics/layer_6="pickups"
3d_physics/layer_7="interactables"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
textures/vram_compression/import_etc2_astc=true

[navigation]

3d/default_cell_size=0.4
3d/default_cell_height=0.25
3d/merge_rasterizer_cell_scale=0.001
